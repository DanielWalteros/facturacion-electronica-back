							],
							"body": "{\n  \"codigo\": \"NOT_FOUND\",\n  \"mensaje\": \"Documento de factura no encontrado para idIntFac: 999999\",\n  \"tipoError\": \"NEGOCIO\",\n  \"timestamp\": \"2025-06-15T10:30:00\"\n}"
						}
					]
				},
				{
					"name": "Detalle factura - No encontrada",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/facturacion/facturas/999999",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "facturacion", "facturas", "999999"]
						},
						"description": "Ejemplo con ID inexistente. Retorna HTTP 404."
					}
				}
			]
		},
		{
			"name": "Logs",
			"description": "Historial de logs y trazabilidad por póliza (PRC_GET_DETALLE_LOG)",
			"item": [
				{
					"name": "Obtener logs por póliza",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/facturacion/logs/12345?page=0&size=50",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "facturacion", "logs", "12345"],
							"query": [
								{ "key": "page", "value": "0", "description": "Número de página (default 0)" },
								{ "key": "size", "value": "50", "description": "Tamaño de página (default 50, max 200)" }
							]
						},
						"description": "Retorna el historial paginado de logs y trazabilidad para una póliza específica.\n\n**SP:** PRC_GET_DETALLE_LOG(IP_NUM_SECU_POL, OP_CURSOR)"
					},
					"response": [
						{
							"name": "200 - Logs obtenidos",
							"status": "OK",
							"code": 200,
							"header": [
								{ "key": "Content-Type", "value": "application/json" }
							],
							"body": "{\n  \"content\": [\n    {\n      \"tipoOperacion\": \"EMISION\",\n      \"timestamp\": \"2025-03-15T08:30:00\",\n      \"usuario\": \"SISTEMA\",\n      \"referenciaFactura\": \"FE-2025-001\",\n      \"resultadoOperacion\": \"EXITOSO\",\n      \"detalle\": \"Factura emitida correctamente\"\n    },\n    {\n      \"tipoOperacion\": \"ENVIO_DIAN\",\n      \"timestamp\": \"2025-03-15T08:35:00\",\n      \"usuario\": \"SISTEMA\",\n      \"referenciaFactura\": \"FE-2025-001\",\n      \"resultadoOperacion\": \"EXITOSO\",\n      \"detalle\": \"Factura enviada a la DIAN exitosamente\"\n    },\n    {\n      \"tipoOperacion\": \"VALIDACION_DIAN\",\n      \"timestamp\": \"2025-03-15T09:00:00\",\n      \"usuario\": \"DIAN\",\n      \"referenciaFactura\": \"FE-2025-001\",\n      \"resultadoOperacion\": \"APROBADO\",\n      \"detalle\": \"CUFE asignado: a1b2c3d4...\"\n    }\n  ],\n  \"totalElements\": 3,\n  \"totalPages\": 1,\n  \"currentPage\": 0,\n  \"pageSize\": 50\n}"
						}
					]
				},
				{
