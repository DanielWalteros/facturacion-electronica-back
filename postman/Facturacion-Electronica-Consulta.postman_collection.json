					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/facturacion/logs/99999?page=0&size=50",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "facturacion", "logs", "99999"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "50" }
							]
						},
						"description": "Ejemplo con póliza sin logs. Retorna HTTP 200 con contenido vacío."
					},
					"response": [
						{
							"name": "200 - Sin logs",
							"status": "OK",
							"code": 200,
							"header": [
